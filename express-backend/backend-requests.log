[2026-06-12T13:43:27.127Z] [Backend] Response for GET /?id=cmqaz8g5w000128f750n2azer (status 200): {"submission":{"id":"cmqaz8g5w000128f750n2azer","problemId":"cmq9pj9kk0000xexa57k5wvyn","userId":"user_3F2LDgRvP69r7JwwB8yu1ns81Ga","languageId":2,"createdAt":"2026-06-12T13:43:13.352Z","updatedAt":"2026-06-12T13:43:24.637Z","code":"// Definition for singly-linked list.\n// struct ListNode {\n//     int val;\n//     ListNode *next;\n//     ListNode(int x) : val(x), next(nullptr) {}\n// };\n\n#include <bits/stdc++.h>\nusing namespace std;\n\nclass Solution {\npublic:\n    ListNode* solve(ListNode* head) {\n        ListNode* prev = NULL;\n        ListNode* curr = head;\n\n        ListNode* next = NULL;\n\n        while(curr != NULL){\n            next = curr->next;\n            curr->next = prev;\n            prev = curr;\n            curr = next;\n        }\n\n        return prev;\n    }\n};\n","fullCode":"#include <iostream>\n#include <vector>\n#include <sstream>\n\nstruct ListNode {\n    int val;\n    ListNode* next;\n    ListNode(int x) : val(x), next(nullptr) {}\n};\n\n// Definition for singly-linked list.\n// struct ListNode {\n//     int val;\n//     ListNode *next;\n//     ListNode(int x) : val(x), next(nullptr) {}\n// };\n\n#include <bits/stdc++.h>\nusing namespace std;\n\nclass Solution {\npublic:\n    ListNode* solve(ListNode* head) {\n        ListNode* prev = NULL;\n        ListNode* curr = head;\n\n        ListNode* next = NULL;\n\n        while(curr != NULL){\n            next = curr->next;\n            curr->next = prev;\n            prev = curr;\n            curr = next;\n        }\n\n        return prev;\n    }\n};\n\n\nint main() {\n    int size;\n    std::cin >> size;\n    ListNode* head = nullptr;\n    ListNode* tail = nullptr;\n    for (int i = 0; i < size; i++) {\n        int v;\n        std::cin >> v;\n        ListNode* node = new ListNode(v);\n        if (!head) head = node;\n        else tail->next = node;\n        tail = node;\n    }\n    ListNode* result = Solution().solve(head);\n    bool first = true;\n    while (result) {\n        if (!first) std::cout << \" \";\n        std::cout << result->val;\n        first = false;\n        result = result->next;\n    }\n    std::cout << std::endl;\n    return 0;\n}\n","status":"AC","memory":144476,"time":0.026},"testCases":[{"id":"cmqaz8ggw000228f76vcstqbf","createdAt":"2026-06-12T13:43:13.760Z","updatedAt":"2026-06-12T13:43:23.570Z","status":"AC","index":0,"submissionId":"cmqaz8g5w000128f750n2azer","memory":144476,"time":0.019,"judge0TrackingId":"a1a1a292-c296-4ad7-9770-dc46066100b5"},{"id":"cmqaz8ggw000328f729ywgxy3","createdAt":"2026-06-12T13:43:13.760Z","updatedAt":"2026-06-12T13:43:23.935Z","status":"AC","index":1,"submissionId":"cmqaz8g5w000128f750n2azer","memory":136888,"time":0.026,"judge0TrackingId":"4aaf06f9-7d07-49da-a8da-628a040987de"},{"id":"cmqaz8ggw000428f7zu0kzbpl","createdAt":"2026-06-12T13:43:13.760Z","updatedAt":"2026-06-12T13:43:24.112Z","status":"AC","index":2,"submissionId":"cmqaz8g5w000128f750n2azer","memory":138864,"time":0.02,"judge0TrackingId":"834d6d57-65c3-41f2-95fe-e386b86b33f0"},{"id":"cmqaz8ggw000528f74vu08iam","createdAt":"2026-06-12T13:43:13.760Z","updatedAt":"2026-06-12T13:43:24.286Z","status":"AC","index":3,"submissionId":"cmqaz8g5w000128f750n2azer","memory":136948,"time":0.022,"judge0TrackingId":"221674d2-a177-4b28-adbf-15bd10edeea4"}]}
