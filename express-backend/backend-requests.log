[2026-06-12T14:05:21.148Z] [Backend] Response for GET /?id=cmqb00b12000185ks9doeklur (status 200): {"submission":{"id":"cmqb00b12000185ks9doeklur","problemId":"cmq9pj9kk0000xexa57k5wvyn","userId":"user_3F2LDgRvP69r7JwwB8yu1ns81Ga","languageId":6,"createdAt":"2026-06-12T14:04:52.902Z","updatedAt":"2026-06-12T14:05:18.972Z","code":"# Definition for singly-linked list.\n# class ListNode:\n#     def __init__(self, val=0, next=None):\n#         self.val = val\n#         self.next = next\n\nclass Solution:\n    def solve(self, head: Optional[ListNode]) -> Optional[ListNode]:\n        pass\n","fullCode":"import sys\n\nclass ListNode:\n    def __init__(self, val=0, next=None):\n        self.val = val\n        self.next = next\n\n# Definition for singly-linked list.\n# class ListNode:\n#     def __init__(self, val=0, next=None):\n#         self.val = val\n#         self.next = next\n\nclass Solution:\n    def solve(self, head: Optional[ListNode]) -> Optional[ListNode]:\n        pass\n\n\nif __name__ == \"__main__\":\n    lines = sys.stdin.read().split()\n    size = int(lines[0])\n    head = None\n    tail = None\n    for i in range(1, size + 1):\n        node = ListNode(int(lines[i]))\n        if head is None:\n            head = node\n            tail = node\n        else:\n            tail.next = node\n            tail = node\n    result = reverseList(head)\n    vals = []\n    while result:\n        vals.append(str(result.val))\n        result = result.next\n    print(\" \".join(vals))\n","status":"REJECTED","memory":5028,"time":0.453},"testCases":[{"id":"cmqb00h28000285ksmyv68uwf","createdAt":"2026-06-12T14:05:00.895Z","updatedAt":"2026-06-12T14:05:17.819Z","status":"FAIL","index":0,"submissionId":"cmqb00b12000185ks9doeklur","memory":5028,"time":0.453,"judge0TrackingId":"62b4afdd-2da8-4b6f-be1b-c8af835e6030"},{"id":"cmqb00h29000385ks27btgko3","createdAt":"2026-06-12T14:05:00.895Z","updatedAt":"2026-06-12T14:05:18.294Z","status":"FAIL","index":1,"submissionId":"cmqb00b1200